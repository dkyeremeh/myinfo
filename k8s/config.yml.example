apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
data:
  # auth

  AUTH_UI_URL: http://localhost:30001
  AUTH_PARENT_HOST: http://localhost:30000
  AUTH_API_URL: http://localhost:30002/api
  AUTH_DB_HOST: auth-db
  AUTH_DB_USER: db
  AUTH_DB_PASS: yourpassword
  AUTH_DB_NAME: db

  # myinfo
  MYINFO_API_URL: http://localhost:30003/auth
  MYINFO_DB_HOST: myinfo-db
  MYINFO_DB_USER: db
  MYINFO_DB_PASS: yourpassword
  MYINFO_DB_NAME: db

  # Internal service-to-service URLs (not exposed outside the cluster)
  MYINFO_API_INTERNAL_URL: http://myinfo-api:5050
  MYINFO_SCANNER_URL: http://myinfo-scanner:5050

  # Shared secret required on internal service-to-service requests
  INTERNAL_API_KEY: yourinternalkey

  JWT_SECRET: s0mes3cre5
